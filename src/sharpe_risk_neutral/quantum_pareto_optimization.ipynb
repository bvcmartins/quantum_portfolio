    "def run_quantum_experiment(results_path, data, volume_data, optimization_function, method_name, parameters):\n",
    "    \"\"\"\n",
    "    Run quantum multi-objective Pareto frontier experiment.\n",
    "    \n",
    "    ⚠️ This function consumes D-Wave quantum processing time!\n",
    "    \n",
    "    Args:\n",
    "        results_path: Path to save results\n",
    "        data: Stock price data\n",
    "        volume_data: Volume data for liquidity\n",
    "        optimization_function: Quantum optimization function\n",
    "        method_name: Name of the method for logging\n",
    "        parameters: Optimization parameters\n",
    "    \n",
    "    Returns:\n",
    "        Quantum Pareto frontier solutions\n",
    "    \"\"\"\n",
    "    if os.path.exists(results_path):\n",
    "        print(f\"Loading existing quantum results for {method_name}...\")\n",
    "        print(f\"💰 No D-Wave machine time consumed (cached results)\")\n",
    "        return read_quantum_results(results_path)\n",
    "    \n",
    "    if not DWAVE_AVAILABLE:\n",
    "        print(f\"❌ Cannot run {method_name} - D-Wave not available\")\n",
    "        return {\n",
    "            'method': method_name,\n",
    "            'pareto_solutions': [],\n",
    "            'execution_time': 0,\n",
    "            'error': 'D-Wave not available'\n",
    "        }\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"⚡ Running {method_name} Quantum Multi-Objective Optimization\")\n",
    "    print(f\"{'='*60}\")\n",
    "    print(f\"Assets: {len(data.columns)}\")\n",
    "    print(f\"Date range: {data.index[0]} to {data.index[-1]}\")\n",
    "    print(f\"💰 D-Wave machine time will be consumed!\")\n",
    "    \n",
    "    # Confirm quantum execution\n",
    "    if 'quantum' in method_name.lower():\n",
    "        print(f\"\\n⚠️  QUANTUM EXECUTION WARNING:\")\n",
    "        print(f\"   This will consume D-Wave QPU time\")\n",
    "        print(f\"   Ensure you have adequate credits\")\n",
    "        print(f\"   Consider running classical baseline first\")\n",
    "    \n",
    "    try:\n",
    "        start_time = datetime.now()\n",
    "        \n",
    "        # Run quantum optimization\n",
    "        print(f\"\\n🚀 Starting quantum optimization...\")\n",
    "        pareto_solutions = optimization_function(data, volume_data, **parameters)\n",
    "        \n",
    "        end_time = datetime.now()\n",
    "        execution_time = (end_time - start_time).total_seconds()\n",
    "        \n",
    "        print(f\"\\n✅ {method_name} completed in {execution_time:.2f} seconds\")\n",
    "        print(f\"🔍 Found {len(pareto_solutions)} Quantum Pareto-optimal solutions\")\n",
    "        print(f\"💰 D-Wave machine time consumed: {execution_time:.2f} seconds\")\n",
    "        \n",
    "        # Prepare results\n",
    "        results = {\n",
    "            'method': method_name,\n",
    "            'pareto_solutions': pareto_solutions,\n",
    "            'execution_time': execution_time,\n",
    "            'n_assets': len(data.columns),\n",
    "            'n_solutions': len(pareto_solutions),\n",
    "            'parameters': parameters,\n",
    "            'start_date': data.index[0],\n",
    "            'end_date': data.index[-1],\n",
    "            'quantum_system': 'D-Wave',\n",
    "            'machine_time_used': True\n",
    "        }\n",
    "        \n",
    "        # Save results\n",
    "        write_quantum_results(results, results_path)\n",
    "        \n",
    "        return results\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ {method_name} failed: {e}\")\n",
    "        logger.error(f\"Quantum {method_name} optimization error: {e}\")\n",
    "        print(f\"💸 D-Wave machine time may have been consumed despite failure\")\n",
    "        \n",
    "        # Return empty results\n",
    "        return {\n",
    "            'method': method_name,\n",
    "            'pareto_solutions': [],\n",
    "            'execution_time': 0,\n",
    "            'error': str(e),\n",
    "            'machine_time_used': True\n",
    "        }"
   ]
