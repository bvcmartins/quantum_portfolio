    "def analyze_quantum_pareto_frontier(results, method_name):\n",
    "    \"\"\"\n",
    "    Analyze quantum Pareto frontier results.\n",
    "    \n",
    "    Args:\n",
    "        results: Results dictionary from run_quantum_experiment\n",
    "        method_name: Name of the method\n",
    "    \n",
    "    Returns:\n",
    "        Analysis DataFrame\n",
    "    \"\"\"\n",
    "    if not results or not results.get('pareto_solutions'):\n",
    "        print(f\"⚠️  No quantum solutions to analyze for {method_name}\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    solutions = results['pareto_solutions']\n",
    "    data = []\n",
    "    \n",
    "    for i, solution in enumerate(solutions):\n",
    "        obj = solution['objectives']\n",
    "        weights = solution['weights']\n",
    "        \n",
    "        # Find top 3 holdings\n",
    "        top_indices = np.argsort(weights)[-3:][::-1]\n",
    "        \n",
    "        row = {\n",
    "            'solution_id': i,\n",
    "            'method': method_name,\n",
    "            'return': obj['return'],\n",
    "            'risk': obj['risk'],\n",
    "            'liquidity': obj['liquidity'],\n",
    "            'sharpe': obj['sharpe'],\n",
    "            'top_weight_1': weights[top_indices[0]] if len(top_indices) > 0 else 0,\n",
    "            'top_weight_2': weights[top_indices[1]] if len(top_indices) > 1 else 0,\n",
    "            'top_weight_3': weights[top_indices[2]] if len(top_indices) > 2 else 0,\n",
    "            'weight_concentration': np.sum(np.sort(weights)[-3:]),  # Top 3 concentration\n",
    "            'effective_assets': np.sum(weights > 0.01),  # Assets with >1% allocation\n",
    "            'quantum_system': 'D-Wave'\n",
    "        }\n",
    "        \n",
    "        # Add quantum-specific info if available\n",
    "        if 'strategy' in solution:\n",
    "            row['strategy'] = solution['strategy']\n",
    "        if 'energy' in solution:\n",
    "            row['energy'] = solution['energy']\n",
    "        if 'chain_break_fraction' in solution:\n",
    "            row['chain_break_fraction'] = solution['chain_break_fraction']\n",
    "            \n",
    "        data.append(row)\n",
    "    \n",
    "    df = pd.DataFrame(data)\n",
    "    \n",
    "    # Print quantum-specific summary\n",
    "    print(f\"\\n🔬 {method_name} Quantum Pareto Frontier Analysis:\")\n",
    "    print(f\"   Solutions found: {len(df)}\")\n",
    "    print(f\"   Return range: {df['return'].min():.6f} to {df['return'].max():.6f}\")\n",
    "    print(f\"   Risk range: {df['risk'].min():.6f} to {df['risk'].max():.6f}\")\n",
    "    print(f\"   Liquidity range: {df['liquidity'].min():.4f} to {df['liquidity'].max():.4f}\")\n",
    "    print(f\"   Sharpe range: {df['sharpe'].min():.4f} to {df['sharpe'].max():.4f}\")\n",
    "    print(f\"   Avg effective assets: {df['effective_assets'].mean():.1f}\")\n",
    "    print(f\"   Avg concentration (top 3): {df['weight_concentration'].mean():.3f}\")\n",
    "    \n",
    "    machine_time_used = results.get('machine_time_used', False)\n",
    "    execution_time = results.get('execution_time', 0)\n",
    "    print(f\"   💰 D-Wave time consumed: {execution_time:.2f}s ({'Yes' if machine_time_used else 'No (cached)'})\")\n",
    "    \n",
    "    return df"
   ]
  },
