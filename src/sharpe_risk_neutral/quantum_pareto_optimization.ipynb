    "            print(f\"   Quantum min risk: {quantum_methods['Min_Risk'].min():.6f}\")\n",
    "            print(f\"   Classical min risk: {classical_methods['Min_Risk'].min():.6f}\")\n",
    "            print(f\"   Quantum max liquidity: {quantum_methods['Max_Liquidity'].max():.4f}\")\n",
    "            print(f\"   Classical max liquidity: {classical_methods['Max_Liquidity'].max():.4f}\")\n",
    "            \n",
    "            print(f\"\\n🌈 Solution Diversity:\")\n",
    "            print(f\"   Quantum return std: {quantum_methods['Return_Std'].mean():.6f}\")\n",
    "            print(f\"   Classical return std: {classical_methods['Return_Std'].mean():.6f}\")\n",
    "            print(f\"   Quantum liquidity std: {quantum_methods['Liquidity_Std'].mean():.6f}\")\n",
    "            print(f\"   Classical liquidity std: {classical_methods['Liquidity_Std'].mean():.6f}\")\n",
    "            \n",
    "            # Determine winners\n",
    "            print(f\"\\n🏆 QUANTUM ADVANTAGES:\")\n",
    "            advantages = []\n",
    "            if quantum_methods['Solutions'].mean() > classical_methods['Solutions'].mean():\n",
    "                advantages.append(\"✅ More Pareto solutions generated\")\n",
    "            if quantum_methods['Return_Std'].mean() > classical_methods['Return_Std'].mean():\n",
    "                advantages.append(\"✅ Better solution diversity (return)\")\n",
    "            if quantum_methods['Max_Return'].max() > classical_methods['Max_Return'].max():\n",
    "                advantages.append(\"✅ Higher maximum returns achieved\")\n",
    "            if quantum_methods['Min_Risk'].min() < classical_methods['Min_Risk'].min():\n",
    "                advantages.append(\"✅ Lower minimum risk achieved\")\n",
    "            \n",
    "            print(f\"\\n🏆 CLASSICAL ADVANTAGES:\")\n",
    "            classical_advantages = []\n",
    "            if classical_methods['Solutions'].mean() > quantum_methods['Solutions'].mean():\n",
