    "def plot_quantum_vs_classical_3d(quantum_results, classical_results, title=\"Quantum vs Classical Pareto Frontiers\", dataset_name=\"\"):\n",
    "    \"\"\"\n",
    "    Plot 3D comparison of quantum vs classical Pareto frontiers.\n",
    "    \n",
    "    Args:\n",
    "        quantum_results: Dictionary of quantum results\n",
    "        classical_results: Dictionary of classical results\n",
    "        title: Plot title\n",
    "        dataset_name: Dataset identifier\n",
    "    \"\"\"\n",
    "    fig = plt.figure(figsize=(18, 12))\n",
    "    ax = fig.add_subplot(111, projection='3d')\n",
    "    \n",
    "    # Quantum methods in warm colors\n",
    "    quantum_colors = ['red', 'orange', 'magenta', 'crimson', 'darkred']\n",
    "    # Classical methods in cool colors  \n",
    "    classical_colors = ['blue', 'green', 'cyan', 'navy', 'darkgreen']\n",
    "    \n",
    "    quantum_idx = 0\n",
    "    classical_idx = 0\n",
    "    \n",
    "    # Plot quantum results\n",
    "    for method_name, results in quantum_results.items():\n",
    "        if not results or not results.get('pareto_solutions'):\n",
    "            continue\n",
    "            \n",
    "        solutions = results['pareto_solutions']\n",
    "        if not solutions:\n",
    "            continue\n",
    "            \n",
    "        returns = [sol['objectives']['return'] for sol in solutions]\n",
    "        risks = [sol['objectives']['risk'] for sol in solutions] \n",
    "        liquidities = [sol['objectives']['liquidity'] for sol in solutions]\n",
    "        \n",
    "        if returns and risks and liquidities:\n",
    "            color = quantum_colors[quantum_idx % len(quantum_colors)]\n",
    "            ax.scatter(returns, risks, liquidities, \n",
    "                      c=color, label=f'⚡ {method_name} ({len(returns)} sols)', \n",
    "                      s=80, alpha=0.8, edgecolors='black', linewidth=0.5, marker='o')\n",
    "            quantum_idx += 1\n",
    "    \n",
    "    # Plot classical results\n",
    "    for method_name, results in classical_results.items():\n",
    "        if not results or not results.get('pareto_solutions'):\n",
    "            continue\n",
    "            \n",
    "        solutions = results['pareto_solutions']\n",
    "        if not solutions:\n",
    "            continue\n",
    "            \n",
    "        returns = [sol['objectives']['return'] for sol in solutions]\n",
    "        risks = [sol['objectives']['risk'] for sol in solutions] \n",
    "        liquidities = [sol['objectives']['liquidity'] for sol in solutions]\n",
    "        \n",
    "        if returns and risks and liquidities:\n",
    "            color = classical_colors[classical_idx % len(classical_colors)]\n",
    "            ax.scatter(returns, risks, liquidities, \n",
    "                      c=color, label=f'🔬 {method_name} ({len(returns)} sols)', \n",
    "                      s=60, alpha=0.7, edgecolors='black', linewidth=0.5, marker='^')\n",
    "            classical_idx += 1\n",
    "    \n",
    "    ax.set_xlabel('Expected Return', fontsize=12)\n",
    "    ax.set_ylabel('Risk (Volatility)', fontsize=12)\n",
    "    ax.set_zlabel('Liquidity Score', fontsize=12)\n",
    "    ax.set_title(f'{title}\\n{dataset_name}\\n⚡=Quantum 🔬=Classical', fontsize=14, pad=30)\n",
    "    \n",
    "    # Improve legend\n",
    "    ax.legend(bbox_to_anchor=(1.15, 0.5), loc='center left', fontsize=10)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
