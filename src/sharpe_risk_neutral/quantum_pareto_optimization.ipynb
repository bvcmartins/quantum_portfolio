    "            if classical_methods['Execution_Time'].mean() < quantum_methods['Execution_Time'].mean():\n",
    "                classical_advantages.append(\"✅ Faster execution time\")\n",
    "            if classical_methods['Return_Std'].mean() > quantum_methods['Return_Std'].mean():\n",
    "                classical_advantages.append(\"✅ Better solution diversity (return)\")\n",
    "                \n",
    "            for advantage in (advantages if advantages else [\"   No clear quantum advantages detected\"]):\n",
