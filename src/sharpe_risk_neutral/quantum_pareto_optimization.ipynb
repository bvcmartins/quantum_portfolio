    "def compare_quantum_vs_classical(quantum_results, classical_results, dataset_name=\"\"):\n",
    "    \"\"\"\n",
    "    Compare quantum results against classical baseline.\n",
    "    \n",
    "    Args:\n",
    "        quantum_results: Dictionary of quantum method results\n",
    "        classical_results: Dictionary of classical method results\n",
    "        dataset_name: Dataset identifier\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*80}\")\n",
    "    print(f\"⚡ QUANTUM VS CLASSICAL PARETO OPTIMIZATION COMPARISON - {dataset_name}\")\n",
    "    print(f\"{'='*80}\")\n",
    "    \n",
    "    all_results = {**quantum_results, **classical_results}\n",
    "    comparison_data = []\n",
    "    \n",
    "    for method_name, results in all_results.items():\n",
    "        if not results:\n",
    "            comparison_data.append({\n",
    "                'Method': method_name,\n",
    "                'Type': 'Quantum' if 'quantum' in method_name.lower() or 'dwave' in method_name.lower() else 'Classical',\n",
    "                'Solutions': 0,\n",
    "                'Execution_Time': 0,\n",
    "                'Status': 'Failed'\n",
    "            })\n",
    "            continue\n",
    "            \n",
    "        solutions = results.get('pareto_solutions', [])\n",
    "        method_type = 'Quantum' if 'quantum' in method_name.lower() or 'dwave' in method_name.lower() else 'Classical'\n",
    "        \n",
    "        if solutions:\n",
    "            # Calculate frontier metrics\n",
    "            returns = [sol['objectives']['return'] for sol in solutions]\n",
    "            risks = [sol['objectives']['risk'] for sol in solutions]\n",
    "            liquidities = [sol['objectives']['liquidity'] for sol in solutions]\n",
    "            sharpes = [sol['objectives']['sharpe'] for sol in solutions]\n",
    "            \n",
    "            comparison_data.append({\n",
    "                'Method': method_name,\n",
    "                'Type': method_type,\n",
    "                'Solutions': len(solutions),\n",
    "                'Execution_Time': results.get('execution_time', 0),\n",
    "                'Max_Return': max(returns),\n",
    "                'Min_Risk': min(risks),\n",
    "                'Max_Liquidity': max(liquidities),\n",
    "                'Max_Sharpe': max(sharpes),\n",
    "                'Avg_Return': np.mean(returns),\n",
    "                'Avg_Risk': np.mean(risks),\n",
    "                'Avg_Liquidity': np.mean(liquidities),\n",
    "                'Avg_Sharpe': np.mean(sharpes),\n",
    "                'Return_Std': np.std(returns),\n",
    "                'Risk_Std': np.std(risks),\n",
    "                'Liquidity_Std': np.std(liquidities),\n",
    "                'Status': 'Success'\n",
    "            })\n",
    "        else:\n",
    "            comparison_data.append({\n",
    "                'Method': method_name,\n",
    "                'Type': method_type,\n",
    "                'Solutions': 0,\n",
    "                'Execution_Time': results.get('execution_time', 0),\n",
    "                'Status': 'No Solutions'\n",
    "            })\n",
    "    \n",
    "    comparison_df = pd.DataFrame(comparison_data)\n",
    "    \n",
    "    # Display summary by type\n",
    "    print(\"\\n📊 Method Comparison Summary:\")\n",
    "    summary_display = comparison_df[['Method', 'Type', 'Solutions', 'Execution_Time', 'Status']].round(2)\n",
    "    display(summary_display)\n",
    "    \n",
    "    # Analyze quantum vs classical performance\n",
    "    successful_methods = comparison_df[comparison_df['Status'] == 'Success']\n",
    "    \n",
    "    if not successful_methods.empty:\n",
    "        quantum_methods = successful_methods[successful_methods['Type'] == 'Quantum']\n",
    "        classical_methods = successful_methods[successful_methods['Type'] == 'Classical']\n",
    "        \n",
    "        print(\"\\n📈 Detailed Performance Metrics:\")\n",
    "        metrics_df = successful_methods[[\n",
    "            'Method', 'Type', 'Max_Return', 'Min_Risk', 'Max_Liquidity', 'Max_Sharpe',\n",
    "            'Avg_Return', 'Avg_Risk', 'Avg_Liquidity', 'Return_Std', 'Liquidity_Std'\n",
    "        ]].round(6)\n",
    "        display(metrics_df)\n",
    "        \n",
    "        # Quantum vs Classical Analysis\n",
